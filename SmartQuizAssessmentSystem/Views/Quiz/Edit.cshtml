@model QuizSystemModel.ViewModels.QuizViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Quiz";
    bool isInstructor = ViewBag.IsInstructor == true;
}

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Edit Quiz</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter quiz name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EducationMediumId" class="form-label fw-bold">Education Medium</label>
                        @if (isInstructor)
                        {
                            <select class="form-select bg-light" asp-items="ViewBag.EducationMediumId"
                                    id="mediumSelect" disabled></select>
                            <input type="hidden" name="EducationMediumId" id="EducationMediumId" value="@(Model.EducationMediumId ?? ViewBag.FixedMediumId)" />
                            <small class="text-muted"><i class="fas fa-lock me-1"></i>Fixed to your assigned medium</small>
                        }
                        else
                        {
                            <select asp-for="EducationMediumId" class="form-select" asp-items="ViewBag.EducationMediumId"
                                    id="mediumSelect">
                                <option value="">Select Education Medium</option>
                            </select>
                        }
                        <span asp-validation-for="EducationMediumId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ClassId" class="form-label fw-bold">Class</label>
                        @if (isInstructor && ViewBag.FixedClassId != null)
                        {
                            <select class="form-select bg-light" asp-items="ViewBag.ClassId"
                                    id="classSelect" disabled></select>
                            <input type="hidden" name="ClassId" id="ClassId" value="@(Model.ClassId ?? ViewBag.FixedClassId)" />
                            <small class="text-muted"><i class="fas fa-lock me-1"></i>Fixed to your assigned class</small>
                        }
                        else
                        {
                            <select asp-for="ClassId" class="form-select" asp-items="ViewBag.ClassId" id="classSelect">
                                <option value="">Select Class</option>
                            </select>
                        }
                        <span asp-validation-for="ClassId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="SubjectId" class="form-label fw-bold">Subject</label>
                        @if (isInstructor)
                        {
                            <select class="form-select bg-light" asp-items="ViewBag.SubjectId"
                                    id="subjectSelect" disabled></select>
                            <input type="hidden" name="SubjectId" id="SubjectId" value="@(Model.SubjectId ?? ViewBag.FixedSubjectId)" />
                            <small class="text-muted"><i class="fas fa-lock me-1"></i>Fixed to your assigned subject</small>
                        }
                        else
                        {
                            <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId"
                                    id="subjectSelect">
                                <option value="">Select Subject</option>
                            </select>
                        }
                        <span asp-validation-for="SubjectId" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter quiz description"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StartAt" class="form-label fw-bold">Start Time</label>
                        <input asp-for="StartAt" type="datetime-local" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EndAt" class="form-label fw-bold">End Time</label>
                        <input asp-for="EndAt" type="datetime-local" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DurationMinutes" class="form-label fw-bold">Duration (Minutes)</label>
                        <input asp-for="DurationMinutes" type="number" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TotalMarks" class="form-label fw-bold">Total Marks</label>
                        <input asp-for="TotalMarks" class="form-control" />
                        <span asp-validation-for="TotalMarks" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NegativeMarking" class="form-label fw-bold">Negative Marking</label>
                        <input asp-for="NegativeMarking" class="form-control" />
                        <span asp-validation-for="NegativeMarking" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RequiredPassPercentage" class="form-label fw-bold">Pass Percentage (%)</label>
                        <input asp-for="RequiredPassPercentage" class="form-control" />
                        <span asp-validation-for="RequiredPassPercentage" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="fas fa-save me-1"></i> Update Quiz
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 shadow-sm">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var isInstructor = @(isInstructor ? "true" : "false");

            $('#mediumSelect').change(function () {
                var mediumId = $(this).val();
                $('#classSelect').empty().append('<option value="">Select Class</option>');
                if (!isInstructor) {
                    $('#subjectSelect').empty().append('<option value="">Select Subject</option>');
                }
                if (mediumId) {
                    $.ajax({
                        url: '@Url.Action("GetClasses", "Quiz")',
                        type: 'GET',
                        data: { mediumId: mediumId },
                        success: function (data) {
                            $.each(data, function (i, item) {
                                $('#classSelect').append($('<option>', { value: item.id, text: item.name }));
                            });
                        }
                    });
                }
            });

            $('#classSelect').change(function () {
                if (isInstructor) return;
                var classId = $(this).val();
                $('#subjectSelect').empty().append('<option value="">Select Subject</option>');
                if (classId) {
                    $.ajax({
                        url: '@Url.Action("GetSubjects", "Quiz")',
                        type: 'GET',
                        data: { classId: classId },
                        success: function (data) {
                            $.each(data, function (i, item) {
                                $('#subjectSelect').append($('<option>', { value: item.id, text: item.name }));
                            });
                        }
                    });
                }
            });

            // Instructor: auto-populate classes for their medium only if class is not fixed
            if (isInstructor && @(ViewBag.FixedClassId == null ? "true" : "false")) {
                var mediumId = '@(ViewBag.FixedMediumId ?? "")';
                var selectedClassId = @(Model.ClassId.HasValue ? Model.ClassId.Value.ToString() : "null");
                if (mediumId && $('#classSelect option').length <= 1) {
                    $.ajax({
                        url: '@Url.Action("GetClasses", "Quiz")',
                        type: 'GET',
                        data: { mediumId: mediumId },
                        success: function (data) {
                            $('#classSelect').empty().append('<option value="">Select Class</option>');
                            $.each(data, function (i, item) {
                                var opt = $('<option>', { value: item.id, text: item.name });
                                if (selectedClassId && item.id == selectedClassId) opt.prop('selected', true);
                                $('#classSelect').append(opt);
                            });
                        }
                    });
                }
            }
        });
    </script>
}
