@model IEnumerable<QuizSystemModel.Models.QuestionBank>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var quiz = ViewBag.Quiz as QuizSystemModel.Models.Quiz;
    long? quizId = ViewBag.QuizId as long?;
    string subject = ViewBag.Subject as string;
    var quizzes = ViewBag.Quizzes as List<QuizSystemModel.Models.Quiz>;
    var subjects = ViewBag.Subjects as List<QuizSystemModel.Models.Subject>;
    
    ViewData["Title"] = quiz != null ? "Questions - " + quiz.Name : "All Questions - Question Bank";
    
    var currentMarks = Model.Sum(x => x.Marks);
    var isOverMarks = quiz != null && currentMarks > quiz.TotalMarks;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header Card -->
            <div class="card shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-dark text-white p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-1 fw-bold">@(quiz != null ? quiz.Name : "Question Bank (All Questions)")</h3>
                            <p class="mb-0 text-white-50"><i class="fas fa-list-ol me-1"></i> Question Bank & Topic Management</p>
                        </div>
                        <div class="d-flex gap-2">
                            @if (quiz != null)
                            {
                                <a asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3 fw-bold">
                                    <i class="fas fa-layer-group me-1"></i> View All Questions
                                </a>
                            }
                            <a asp-controller="Quiz" asp-action="Index" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark shadow-sm">
                                <i class="fas fa-tasks me-1"></i> Manage Quizzes
                            </a>
                        </div>
                    </div>
                </div>
                
                @if (quiz != null)
                {
                    <div class="card-body bg-light border-bottom p-4">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="p-3 bg-white rounded-3 shadow-sm text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Marks</div>
                                    <div class="h4 mb-0 fw-bold text-primary">@quiz.TotalMarks</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-white rounded-3 shadow-sm text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Questions</div>
                                    <div class="h4 mb-0 fw-bold">@Model.Count()</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-white rounded-3 shadow-sm text-center border-bottom border-3 @(isOverMarks ? "border-danger" : "border-success")">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Marks Assigned</div>
                                    <div class="h4 mb-0 fw-bold @(isOverMarks ? "text-danger" : "text-success")">@currentMarks</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="p-3 bg-white rounded-3 shadow-sm text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Neg. Marking</div>
                                    <div class="h4 mb-0 fw-bold text-warning">@quiz.NegativeMarking</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-body bg-light border-bottom p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded-3 shadow-sm text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Total Questions</div>
                                    <div class="h4 mb-0 fw-bold text-primary">@Model.Count()</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded-3 shadow-sm text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Active Quizzes</div>
                                    <div class="h4 mb-0 fw-bold text-success">@(quizzes?.Count ?? 0)</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-white rounded-3 shadow-sm text-center">
                                    <div class="text-muted small fw-bold text-uppercase mb-1">Topics / Subjects</div>
                                    <div class="h4 mb-0 fw-bold text-warning">@(subjects?.Count ?? 0)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="card-body bg-white p-4 d-flex flex-wrap gap-3 align-items-center">
                    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
                        <!-- Topic / Subject Dropdown Filter -->
                        <div class="input-group input-group-sm" style="max-width: 250px;">
                            <label class="input-group-text bg-white border-end-0 text-muted fw-bold"><i class="fas fa-filter me-1 text-primary"></i> Topic</label>
                            <select name="subject" class="form-select border-start-0 ps-0" onchange="this.form.submit()">
                                <option value="" selected="@(string.IsNullOrEmpty(subject))">All Topics / Subjects</option>
                                @if (subjects != null)
                                {
                                    foreach (var subj in subjects)
                                    {
                                        <option value="@subj.Name" selected="@(subject == subj.Name)">@subj.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Quiz Dropdown Filter -->
                        <div class="input-group input-group-sm" style="max-width: 260px;">
                            <label class="input-group-text bg-white border-end-0 text-muted fw-bold"><i class="fas fa-tasks me-1 text-warning"></i> Quiz</label>
                            <select name="quizId" class="form-select border-start-0 ps-0" onchange="this.form.submit()">
                                <option value="" selected="@(!quizId.HasValue || quizId.Value == 0)">All Quizzes</option>
                                @if (quizzes != null)
                                {
                                    foreach (var qz in quizzes)
                                    {
                                        <option value="@qz.Id" selected="@(quizId == qz.Id)">@qz.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        @if (!string.IsNullOrEmpty(subject) || (quizId.HasValue && quizId.Value > 0))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                <i class="fas fa-undo me-1"></i> Reset
                            </a>
                        }
                    </form>

                    <div class="ms-auto">
                        <a asp-action="Create" asp-route-quizId="@quiz?.Id" asp-route-subject="@subject" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                            <i class="fas fa-plus me-2"></i> Add Question
                        </a>
                    </div>
                </div>
            </div>

            <!-- Questions List (Centered Cards) -->
            <div class="questions-container">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
                        <i class="fas fa-question-circle fa-4x text-muted opacity-50 mb-3"></i>
                        <h4 class="text-muted">No questions found.</h4>
                        <p class="text-muted mb-3">Try adjusting your Topic/Quiz filter or add a new question.</p>
                        <a asp-action="Create" asp-route-quizId="@quiz?.Id" asp-route-subject="@subject" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                            <i class="fas fa-plus me-2"></i> Add Question Now
                        </a>
                    </div>
                }
                else
                {
                    int counter = 1;
                    foreach (var q in Model)
                    {
                        <div class="card shadow-sm border-0 rounded-4 mb-4 question-card hover-actions">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-bold">
                                            Q @(counter++)
                                        </span>
                                        <span class="badge bg-info text-dark px-2 py-1 rounded-3">
                                            <i class="fas fa-tag me-1"></i>Topic: @q.Subject
                                        </span>
                                        @if (q.Quiz != null)
                                        {
                                            <span class="badge bg-dark bg-opacity-75 text-white px-2 py-1 rounded-3">
                                                <i class="fas fa-tasks me-1 text-warning"></i>Quiz: @q.Quiz.Name
                                            </span>
                                            @if (q.Quiz.EducationMedium != null)
                                            {
                                                <span class="badge bg-success bg-opacity-25 text-dark border border-success-subtle px-2 py-1 rounded-3">
                                                    <i class="fas fa-book me-1 text-success"></i>@q.Quiz.EducationMedium.Name
                                                </span>
                                            }
                                        }
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-dark fs-5">@q.Marks Marks</div>
                                        <div class="small text-success fw-bold"><i class="fas fa-check-circle me-1"></i> Correct: Option @q.RightOption</div>
                                    </div>
                                </div>
                                
                                <h5 class="fw-bold mb-3 text-dark lh-base">@q.QuestionText</h5>

                                @if (!string.IsNullOrWhiteSpace(q.Description))
                                {
                                    <div class="p-2 px-3 mb-3 bg-light rounded-3 border-start border-3 border-info small text-muted">
                                        <span class="fw-bold text-info"><i class="fas fa-lightbulb me-1"></i> Explanation:</span> @q.Description
                                    </div>
                                }

                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 rounded-3 bg-light border-start border-3 @(q.RightOption == "A" ? "border-success bg-success bg-opacity-10" : "border-light")">
                                            <span class="fw-bold me-2">A.</span> @q.OptionA
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 rounded-3 bg-light border-start border-3 @(q.RightOption == "B" ? "border-success bg-success bg-opacity-10" : "border-light")">
                                            <span class="fw-bold me-2">B.</span> @q.OptionB
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 rounded-3 bg-light border-start border-3 @(q.RightOption == "C" ? "border-success bg-success bg-opacity-10" : "border-light")">
                                            <span class="fw-bold me-2">C.</span> @q.OptionC
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 rounded-3 bg-light border-start border-3 @(q.RightOption == "D" ? "border-success bg-success bg-opacity-10" : "border-light")">
                                            <span class="fw-bold me-2">D.</span> @q.OptionD
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2 action-buttons">
                                    <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@q.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .question-card {
        transition: all 0.2s ease;
        border-left: 4px solid transparent !important;
    }
    .question-card:hover {
        transform: translateX(5px);
        border-left-color: #ffc107 !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
    }
    .action-buttons .btn {
        opacity: 0.8;
        transition: all 0.2s ease;
    }
    .question-card:hover .action-buttons .btn {
        opacity: 1;
    }
    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1) !important;
    }
</style>
