@using QuizSystemModel.Models
@model QuizAttempt

@{
    ViewData["Title"] = "Quiz Result";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var scorePercentage = (double)Model.TotalScore / (double)Model.Quiz.TotalMarks * 100;
    var statusClass = Model.IsPassed ? "success" : "danger";
    var statusIcon = Model.IsPassed ? "fa-check-circle" : "fa-times-circle";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header Summary Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5">
                <div class="card-body p-0">
                    <div class="bg-@statusClass p-5 text-center text-white position-relative">
                        <div class="mb-3">
                            <i class="fas @statusIcon fa-5x opacity-50"></i>
                        </div>
                        <h1 class="display-5 fw-bold mb-1">@(Model.IsPassed ? "Congratulations!" : "Keep Practicing!")</h1>
                        <p class="lead opacity-75">You have completed the <span class="fw-bold">@Model.Quiz.Name</span></p>
                        
                        <div class="mt-4 pt-3 border-top border-white border-opacity-10 d-flex justify-content-around">
                            <div>
                                <div class="h3 mb-0 fw-bold">@Model.TotalScore / @Model.Quiz.TotalMarks</div>
                                <div class="small text-uppercase opacity-75">Total Score</div>
                            </div>
                            <div>
                                <div class="h3 mb-0 fw-bold">@Math.Round(scorePercentage, 1)%</div>
                                <div class="small text-uppercase opacity-75">Percentage</div>
                            </div>
                            <div>
                                <div class="h3 mb-0 fw-bold">@(Model.IsPassed ? "Pass" : "Fail")</div>
                                <div class="small text-uppercase opacity-75">Result</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="p-4 bg-white">
                        <div class="row text-center g-4">
                            <div class="col-md-6 border-end">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Started At</div>
                                <div class="fw-bold">@Model.StartAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</div>
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted small text-uppercase fw-bold mb-1">Submitted At</div>
                                <div class="fw-bold">@Model.EndAt?.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detailed Review Section -->
            <div class="d-flex align-items-center mb-4">
                <div class="h4 mb-0 fw-bold">Detailed Review</div>
                <div class="ms-auto">
                    <span class="badge bg-success-subtle text-success border border-success-subtle me-2"><i class="fas fa-check me-1"></i> Correct</span>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-2"><i class="fas fa-times me-1"></i> Wrong</span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="fas fa-minus me-1"></i> Skipped</span>
                </div>
            </div>

            @foreach (var a in Model.Answers.OrderBy(x => x.QuestionBank.Id))
            {
                var q = a.QuestionBank;
                var userChoice = a.SelectedOption?.Trim();
                var rightChoice = q.RightOption?.Trim();
                bool isSkipped = string.IsNullOrWhiteSpace(userChoice);
                bool isCorrect = !isSkipped && string.Equals(userChoice, rightChoice, StringComparison.OrdinalIgnoreCase);
                string borderClass = isCorrect ? "border-success" : (isSkipped ? "border-warning" : "border-danger");

                <div class="card shadow-sm border-0 border-start border-4 @borderClass mb-4 rounded-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h6 class="fw-bold text-dark mb-0 me-3">@q.QuestionText</h6>
                            @if (isCorrect)
                            {
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold"><i class="fas fa-check-circle me-1"></i> Correct (+@q.Marks)</span>
                            }
                            else if (isSkipped)
                            {
                                <span class="badge bg-warning-subtle text-warning px-3 py-2 rounded-pill fw-bold"><i class="fas fa-exclamation-circle me-1"></i> Not Answered</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold"><i class="fas fa-times-circle me-1"></i> Incorrect (-@Model.Quiz.NegativeMarking)</span>
                            }
                        </div>

                        <div class="list-group list-group-flush mb-3">
                            @foreach (var option in new[] { "A", "B", "C", "D" })
                            {
                                string optionText = option switch { "A" => q.OptionA, "B" => q.OptionB, "C" => q.OptionC, "D" => q.OptionD, _ => "" };
                                bool isThisUserChoice = string.Equals(userChoice, option, StringComparison.OrdinalIgnoreCase);
                                bool isThisRightOption = string.Equals(rightChoice, option, StringComparison.OrdinalIgnoreCase);
                                
                                string pillClass = "bg-light text-muted";
                                string textClass = "text-muted";

                                if (isThisRightOption)
                                {
                                    pillClass = "bg-success text-white shadow-sm";
                                    textClass = "fw-bold text-success";
                                }
                                else if (isThisUserChoice && !isCorrect)
                                {
                                    pillClass = "bg-danger text-white shadow-sm";
                                    textClass = "fw-bold text-danger text-decoration-line-through";
                                }

                                <div class="list-group-item border-0 px-0 py-2 d-flex align-items-center">
                                    <div class="option-pill me-3 @pillClass">
                                        @option
                                    </div>
                                    <span class="@textClass">
                                        @optionText
                                    </span>
                                    @if (isThisRightOption)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success ms-auto small">
                                            <i class="fas fa-check me-1"></i> Correct Answer
                                        </span>
                                    }
                                    else if (isThisUserChoice && !isCorrect)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger ms-auto small">
                                            <i class="fas fa-user-times me-1"></i> Your Answer
                                        </span>
                                    }
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(q.Description))
                        {
                            <div class="mt-3 p-3 bg-light rounded-3 border-start border-4 border-info">
                                <div class="fw-bold text-info small mb-1">
                                    <i class="fas fa-lightbulb me-1"></i> Explanation / Solution:
                                </div>
                                <p class="mb-0 text-secondary small lh-base">@q.Description</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Bottom Actions -->
            <div class="text-center mt-5">
                <a asp-controller="StudentDashboard" asp-action="Dashboard" class="btn btn-primary px-5 py-2 rounded-pill shadow-sm fw-bold">
                    <i class="fas fa-home me-2"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .option-pill {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }
    
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-danger-subtle { background-color: #f8d7da; }
    .bg-warning-subtle { background-color: #fff3cd; }
    .bg-secondary-subtle { background-color: #e2e3e5; }
    .text-success { color: #0f5132 !important; }
    .text-danger { color: #842029 !important; }
    .text-warning { color: #664d03 !important; }
    
    .card {
        transition: transform 0.2s ease;
    }
    .card:hover {
        transform: translateY(-2px);
    }
</style>