@using QuizSystemModel.Models
@model IEnumerable<Quiz>

@{
    ViewData["Title"] = "Available Quizzes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Available Quizzes</h2>
            <p class="text-muted small mb-0">Quizzes assigned to your class and education medium.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm rounded-4 p-4">
            <div class="d-flex align-items-center">
                <i class="fas fa-info-circle fa-2x me-3 text-info"></i>
                <div>
                    <h5 class="fw-bold mb-1">No quizzes available</h5>
                    <p class="mb-0 text-muted">There are no quizzes assigned to your class at the moment. Check back later!</p>
                </div>
            </div>
        </div>
    }
    else
    {
        var completedQuizIds = ViewBag.CompletedQuizIds as HashSet<long> ?? new HashSet<long>();
        var inProgressAttempts = ViewBag.InProgressAttempts as Dictionary<long, long> ?? new Dictionary<long, long>();
        var submittedAttempts = ViewBag.SubmittedAttempts as Dictionary<long, long> ?? new Dictionary<long, long>();
        var nowLocal = DateTime.Now;
        var nowUtc = DateTime.UtcNow;

        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var quiz in Model)
            {
                bool isUpcoming = quiz.StartAt.HasValue && (quiz.StartAt.Value.Kind == DateTimeKind.Utc ? nowUtc : nowLocal) < quiz.StartAt.Value;
                bool isEnded = quiz.EndAt.HasValue && (quiz.EndAt.Value.Kind == DateTimeKind.Utc ? nowUtc : nowLocal) > quiz.EndAt.Value;
                bool isCompleted = completedQuizIds.Contains(quiz.Id);
                bool isInProgress = !isCompleted && inProgressAttempts.ContainsKey(quiz.Id);
                bool isLive = !isUpcoming && !isEnded;

                <div class="col">
                    <div class="card h-100 bg-dark text-white shadow-sm border-0 hover-effect rounded-4">
                        <div class="card-body d-flex flex-column p-4">
                            <!-- Card Header: Title and Status Badge -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title text-truncate fw-bold mb-0 me-2" title="@quiz.Name">@quiz.Name</h5>
                                <div class="d-flex gap-1 flex-shrink-0">
                                    @if (isCompleted)
                                    {
                                        <span class="badge bg-info text-dark rounded-pill"><i class="fas fa-check-circle me-1"></i>Completed</span>
                                    }
                                    else if (isInProgress)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill"><i class="fas fa-spinner fa-spin me-1"></i>In Progress</span>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <span class="badge bg-secondary text-white rounded-pill"><i class="fas fa-clock me-1"></i>Upcoming</span>
                                    }
                                    else if (isEnded)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill"><i class="fas fa-ban me-1"></i>Ended</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white rounded-pill"><i class="fas fa-bolt me-1"></i>Live</span>
                                    }
                                </div>
                            </div>

                            <!-- Medium, Subject and Class Badges -->
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                <span class="badge bg-white bg-opacity-10 text-white rounded-pill px-2 py-1 small">
                                    <i class="fas fa-layer-group me-1 text-warning"></i>@(quiz.Subject?.Name ?? "General")
                                </span>
                                <span class="badge bg-white bg-opacity-10 text-white rounded-pill px-2 py-1 small">
                                    <i class="fas fa-book me-1 text-info"></i>@(quiz.EducationMedium?.Name ?? "Medium")
                                </span>
                                <span class="badge bg-white bg-opacity-10 text-white rounded-pill px-2 py-1 small">
                                    <i class="fas fa-graduation-cap me-1 text-success"></i>@(quiz.Class?.Name ?? "Class")
                                </span>
                            </div>
                            
                            <!-- Description -->
                            <p class="card-text text-white-50 small flex-grow-1 mb-3">
                                @if(!string.IsNullOrEmpty(quiz.Description))
                                {
                                     @(quiz.Description.Length > 100 ? quiz.Description.Substring(0, 100) + "..." : quiz.Description)
                                }
                                else
                                {
                                    <span class="fst-italic opacity-50">No description available.</span>
                                }
                            </p>

                            <!-- Availability Notice if not participating -->
                            @if (isUpcoming && quiz.StartAt.HasValue)
                            {
                                <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3 d-flex align-items-center border-0 text-dark bg-warning bg-opacity-75">
                                    <i class="fas fa-clock me-2"></i>
                                    <span><strong>Unavailable:</strong> Starts @quiz.StartAt.Value.ToString("MMM dd, yyyy - hh:mm tt")</span>
                                </div>
                            }
                            else if (isEnded && quiz.EndAt.HasValue)
                            {
                                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center border-0 text-white bg-danger bg-opacity-75">
                                    <i class="fas fa-times-circle me-2"></i>
                                    <span><strong>Unavailable:</strong> Ended @quiz.EndAt.Value.ToString("MMM dd, yyyy - hh:mm tt")</span>
                                </div>
                            }
                            
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between text-white-50 small mb-3 border-top border-secondary pt-3">
                                    <span><i class="fas fa-clock me-1 text-warning"></i> @(quiz.Duration.HasValue ? $"{quiz.Duration.Value.TotalMinutes} min" : "No limit")</span>
                                    <span><i class="fas fa-trophy me-1 text-warning"></i> @quiz.TotalMarks Marks</span>
                                    @if (quiz.NegativeMarking > 0)
                                    {
                                        <span class="text-danger"><i class="fas fa-minus-circle me-1"></i>-@quiz.NegativeMarking</span>
                                    }
                                </div>
                                
                                @if (isCompleted && submittedAttempts.ContainsKey(quiz.Id))
                                {
                                    <a asp-controller="StudentQuiz" asp-action="Result" asp-route-id="@submittedAttempts[quiz.Id]" class="btn btn-outline-info w-100 fw-bold rounded-pill">
                                        <i class="fas fa-poll me-2"></i>View Result
                                    </a>
                                }
                                else if (isInProgress && inProgressAttempts.ContainsKey(quiz.Id))
                                {
                                    <a asp-controller="StudentQuiz" asp-action="Attempt" asp-route-id="@inProgressAttempts[quiz.Id]" class="btn btn-warning w-100 fw-bold text-dark rounded-pill">
                                        <i class="fas fa-play me-2"></i>Resume Quiz
                                    </a>
                                }
                                else if (isUpcoming)
                                {
                                    <button type="button" class="btn btn-secondary w-100 fw-bold rounded-pill text-white-50" disabled title="This quiz has not started yet">
                                        <i class="fas fa-ban me-2"></i>Can't Participate (Not Started)
                                    </button>
                                }
                                else if (isEnded)
                                {
                                    <button type="button" class="btn btn-secondary w-100 fw-bold rounded-pill text-white-50" disabled title="This quiz has already ended">
                                        <i class="fas fa-ban me-2"></i>Can't Participate (Ended)
                                    </button>
                                }
                                else
                                {
                                    <form asp-controller="StudentDashboard" asp-action="StartQuiz" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="quizId" value="@quiz.Id" />
                                        <button type="submit" class="btn btn-light w-100 fw-bold btn-hover-grow text-dark rounded-pill">
                                            Start Quiz <i class="fas fa-arrow-right ms-2"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    <div class="mt-4">
        <a asp-controller="StudentDashboard" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
</div>

<style>
    .hover-effect {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-effect:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
    }
    .btn-hover-grow {
        transition: transform 0.2s;
    }
    .btn-hover-grow:hover {
        transform: scale(1.02);
    }
</style>
