@model QuizSystemModel.ViewModels.MyPerformanceViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "My Performance";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold text-primary"><i class="fas fa-chart-line me-2"></i>My Performance</h2>
            <p class="text-muted">Track your progress and assessment history.</p>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 bg-primary text-white h-100 rounded-4">
                <div class="card-body text-center p-4">
                    <i class="fas fa-clipboard-check fa-2x mb-3 opacity-50"></i>
                    <h3 class="fw-bold mb-0">@Model.TotalAttempts</h3>
                    <div class="small opacity-75 text-uppercase fw-bold ls-1 mt-1">Total Attempts</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0 bg-success text-white h-100 rounded-4">
                <div class="card-body text-center p-4">
                    <i class="fas fa-check-circle fa-2x mb-3 opacity-50"></i>
                    <h3 class="fw-bold mb-0">@Model.QuizzesPassed</h3>
                    <div class="small opacity-75 text-uppercase fw-bold ls-1 mt-1">Quizzes Passed</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
             <div class="card shadow-sm border-0 bg-info text-white h-100 rounded-4">
                <div class="card-body text-center p-4">
                    <i class="fas fa-star fa-2x mb-3 opacity-50"></i>
                    <h3 class="fw-bold mb-0">@Model.AverageScore</h3>
                    <div class="small opacity-75 text-uppercase fw-bold ls-1 mt-1">Avg. Score</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
             @{
                 var rateColor = Model.PassRate >= 70 ? "bg-warning text-dark" : "bg-danger text-white";
             }
            <div class="card shadow-sm border-0 @rateColor h-100 rounded-4">
                <div class="card-body text-center p-4">
                    <i class="fas fa-chart-pie fa-2x mb-3 opacity-50"></i>
                    <h3 class="fw-bold mb-0">@Model.PassRate%</h3>
                    <div class="small opacity-75 text-uppercase fw-bold ls-1 mt-1">Pass Rate</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Attempts Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="fw-bold text-dark mb-0"><i class="fas fa-history me-2 text-primary"></i>Recent Quiz Attempts</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="py-3 ps-4">Date</th>
                            <th class="py-3">Quiz</th>
                            <th class="py-3">Subject</th>
                            <th class="py-3 text-center">Score</th>
                            <th class="py-3 text-center">Status</th>
                            <th class="py-3 text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentAttempts.Any())
                        {
                            @foreach (var attempt in Model.RecentAttempts)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">@attempt.AttemptDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td class="fw-bold text-dark">@attempt.QuizName</td>
                                    <td><span class="badge bg-light text-dark border">@attempt.SubjectName</span></td>
                                    <td class="text-center fw-bold">
                                        @attempt.Score <span class="text-muted fw-normal small">/ @attempt.TotalMarks</span>
                                    </td>
                                    <td class="text-center">
                                        @if (attempt.Passed)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">Passed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">Failed</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="StudentQuiz" asp-action="Result" asp-route-id="@attempt.AttemptId" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            View Result
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-history me-2"></i>No recent attempts found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 1px; }
</style>
