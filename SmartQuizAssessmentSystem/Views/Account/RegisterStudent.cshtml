@model QuizSystemModel.ViewModels.StudentAddViewModel

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Student Registration";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Student Registration</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-3 border-0 py-2 small d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-triangle me-2 fa-lg text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="RegisterStudent" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="EducationMediumId" class="form-label">Medium</label>
                    <select asp-for="EducationMediumId" asp-items="ViewBag.EducationMediumId" class="form-control" id="EducationMediumId">
                        <option value="">Select Medium</option>
                    </select>
                    <span asp-validation-for="EducationMediumId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ClassId" class="form-label">Class</label>
                    <select asp-for="ClassId" asp-items="ViewBag.ClassId" class="form-control" id="ClassId">
                        <option value="">Select Class</option>
                    </select>
                    <span asp-validation-for="ClassId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="Role" value="Student" />

            <button type="submit" class="btn btn-dark w-100 p-2 fw-bold btn-hover-effect mb-3">
                Complete Registration <i class="fas fa-check-circle ms-1"></i>
            </button>
            <div class="text-center pt-3 border-top">
                <a asp-action="Login" class="text-dark fw-bold text-decoration-none small">
                    <i class="fas fa-chevron-left me-1"></i> Already have an account? Login
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script type="text/javascript">
        function loadStudentClasses(mediumId) {
            var classDropdown = $('#ClassId');
            classDropdown.empty();
            classDropdown.append('<option value="">Select Class</option>');

            if (mediumId) {
                $.ajax({
                    url: '@Url.Action("GetClassesByMedium", "Account")',
                    type: 'GET',
                    data: { mediumId: mediumId },
                    success: function (data) {
                        $.each(data, function (index, item) {
                            classDropdown.append($('<option>', {
                                value: item.id,
                                text: item.name
                            }));
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error("Ajax query error:", status, error);
                    }
                });
            }
        }

        $(document).ready(function () {
            $('#EducationMediumId').change(function () {
                var selectedMedium = $(this).val();
                loadStudentClasses(selectedMedium);
            });
        });
    </script>
}
