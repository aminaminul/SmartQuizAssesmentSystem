@model QuizSystemModel.ViewModels.InstructorAddViewModel

@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Instructor Registration";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Instructor Registration</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-3 border-0 py-2 small d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-triangle me-2 fa-lg text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="RegisterInstructor" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EducationMediumId" class="form-label">Specialized Medium</label>
                <select asp-for="EducationMediumId" asp-items="ViewBag.MediumList" class="form-control">
                    <option value="">Select Medium</option>
                </select>
                <span asp-validation-for="EducationMediumId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HscPassingInstitute" class="form-label">HSC Institution</label>
                <input asp-for="HscPassingInstitute" class="form-control" />
                <span asp-validation-for="HscPassingInstitute" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="HscPassingYear" class="form-label">HSC Year</label>
                    <input asp-for="HscPassingYear" class="form-control" />
                    <span asp-validation-for="HscPassingYear" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="HscGrade" class="form-label">HSC GPA</label>
                    <input asp-for="HscGrade" class="form-control" />
                    <span asp-validation-for="HscGrade" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="Role" value="Instructor" />

            <button type="submit" class="btn btn-dark w-100 p-2 fw-bold btn-hover-effect">
                Join Faculty <i class="fas fa-paper-plane ms-1"></i>
            </button>
            <div class="text-center mt-3 pt-3 border-top">
                <a asp-action="Login" class="text-dark fw-bold text-decoration-none small">
                    Already an instructor? Login
                </a>
            </div>
        </form>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }
    </div>
</div>

