@using QuizSystemModel.ViewModels;
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";

    // Portal-specific branding
    var role = Model?.Role;
    var portalTitle     = role == "Admin" ? "Admin Portal Login" : role == "Instructor" ? "Instructor Portal Login" : role == "Student" ? "Student Portal Login" : "Login";
    var portalIcon      = role == "Admin" ? "fa-user-shield"    : role == "Instructor" ? "fa-chalkboard-teacher"   : role == "Student" ? "fa-user-graduate"     : "fa-sign-in-alt";
    var portalBadge     = role == "Admin" ? "bg-dark text-white": role == "Instructor" ? "bg-secondary text-white" : role == "Student" ? "bg-success text-white"  : "";
    var portalBadgeText = role == "Admin" ? "Administrator"     : role == "Instructor" ? "Instructor"              : role == "Student" ? "Student"                : "";
}

<div class="account-container">
    <div class="account-box">

        @* Portal badge header *@
        @if (!string.IsNullOrEmpty(role))
        {
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                     style="width:64px;height:64px;background:rgba(0,0,0,0.08)">
                    <i class="fas @portalIcon fa-2x text-dark"></i>
                </div>
                <div>
                    <span class="badge @portalBadge px-3 py-2 rounded-pill fw-bold mb-2 d-inline-block">
                        @portalBadgeText Portal
                    </span>
                </div>
                <h5 class="fw-bold mb-0">@portalTitle</h5>
                <p class="text-muted small mt-1">Sign in with your @portalBadgeText account</p>
            </div>
        }
        else
        {
            <h2 class="text-center mb-4">Login</h2>
        }

        @* Success Notification (e.g. after Registration) *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4 border-0 py-2 small d-flex align-items-center" role="alert">
                <i class="fas fa-check-circle me-2 fa-lg text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* Error Notification (e.g. invalid credentials, unapproved, role mismatch) *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4 border-0 py-2 small d-flex align-items-center" role="alert">
                <i class="fas fa-exclamation-triangle me-2 fa-lg text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small @(ViewData.ModelState.IsValid ? "d-none" : "")" id="validationBox"></div>

            @* Pass role through form *@
            <input type="hidden" asp-for="Role" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="float-end mb-3">
                <a asp-controller="Account" asp-action="VerifyEmail" class="text-dark text-decoration-none small fw-bold">
                    Forgot password?
                </a>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted small">
                    Remember me
                </label>
            </div>

            <button type="submit" class="btn btn-dark w-100 p-2 fw-bold rounded-3 shadow-sm btn-hover-effect">
                Login <i class="fas fa-sign-in-alt ms-1"></i>
            </button>

            @if (string.IsNullOrEmpty(role))
            {
                <p class="text-center mt-3 text-muted">
                    Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-dark fw-bold text-decoration-none border-bottom border-dark">Register</a>
                </p>
            }

            <div class="text-center mt-4 pt-3 border-top">
                <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small">
                    <i class="fas fa-arrow-left me-1"></i> Back to Home
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
    <script>
        // Show validation box if it has content
        document.addEventListener("DOMContentLoaded", function () {
            var box = document.getElementById("validationBox");
            if (box && box.children.length > 0) {
                box.classList.remove("d-none");
            }
        });
    </script>
}