@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-2">Join Us</h2>
        <p class="text-center text-muted mb-4 small">Select your path to get started.</p>

        <a asp-controller="Account" asp-action="RegisterStudent"
           class="btn btn-dark w-100 p-3 mb-3 btn-hover-effect d-flex align-items-center justify-content-center fw-bold">
            <i class="fas fa-user-graduate me-3 fa-lg"></i>
            Register as Student
        </a>

        <a asp-controller="Account" asp-action="RegisterInstructor"
           class="btn btn-outline-dark w-100 p-3 btn-hover-effect d-flex align-items-center justify-content-center fw-bold">
            <i class="fas fa-chalkboard-teacher me-3 fa-lg"></i>
            Register as Instructor
        </a>

        <div class="text-center mt-4 pt-3 border-top">
            <p class="mb-2 text-muted small">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" class="text-dark fw-bold text-decoration-none border-bottom border-dark">
                    Login
                </a>
            </p>
            <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small">
                <i class="fas fa-arrow-left me-1"></i> Back to Home
            </a>
        </div>
    </div>
</div>
